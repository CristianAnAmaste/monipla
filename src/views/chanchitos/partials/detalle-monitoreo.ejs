<section class="chanchitos-detail-grid">
  <article class="info-panel">
    <h2>Identificación</h2>
    <dl class="chanchitos-detail-list">
      <dt>Fundo</dt><dd><%= detalle.fundo %></dd>
      <dt>Productor / Campo</dt><dd><%= detalle.campo %></dd>
      <dt>Variedad</dt><dd><%= detalle.variedad %></dd>
      <dt>Cuartel</dt><dd><%= detalle.cuartel %></dd>
      <dt>SDP</dt><dd><%= detalle.sdp %></dd>
      <dt>CSG</dt><dd><%= detalle.csg %></dd>
      <dt>Trazabilidad</dt><dd><%= detalle.trazabilidad %></dd>
    </dl>
  </article>
  <article class="info-panel">
    <h2>Monitoreo</h2>
    <dl class="chanchitos-detail-list">
      <dt>Plantas</dt><dd><%= detalle.cantPlantas %></dd>
      <dt>Estado fenológico</dt><dd><%= detalle.estadoFenologico %></dd>
      <dt>Monitoreador</dt><dd><%= detalle.monitoreador %></dd>
      <dt>Fecha de registro</dt><dd><%= detalle.fechaRegistro %></dd>
      <dt>Total bichos</dt><dd><strong><%= detalle.totalBichos %></strong></dd>
      <dt>Posiciones con detección</dt><dd><%= detalle.posicionesConDeteccion %></dd>
    </dl>
  </article>
  <article class="info-panel">
    <h2>Agroclima</h2>
    <dl class="chanchitos-detail-list">
      <dt>Estación</dt><dd><%= detalle.agroclima.estacion %></dd>
      <dt>Horas frío</dt><dd><%= detalle.agroclima.horasFrio === null ? 'Sin datos' : detalle.agroclima.horasFrio %></dd>
      <dt>Días grado</dt><dd><%= detalle.agroclima.diasGrado === null ? 'Sin datos' : detalle.agroclima.diasGrado %></dd>
      <dt>Fecha de corte</dt><dd><%= detalle.agroclima.fechaCorte %></dd>
    </dl>
  </article>
</section>
<section class="info-panel">
  <h2>Observaciones</h2>
  <p><%= detalle.observaciones %></p>
</section>
<section class="data-panel chanchitos-detail-matrix">
  <h2>Matriz de presión</h2>
  <div class="table-wrap">
    <table class="data-table chanchitos-matrix-table">
      <thead><tr><th>Posición</th><th>Ovisaco</th><th>Ninfa</th><th>Adulto</th></tr></thead>
      <tbody>
        <% const posiciones = [{ id: 1, nombre: 'Bajo corteza' }, { id: 2, nombre: 'Base de brote' }, { id: 3, nombre: 'Hoja' }, { id: 4, nombre: 'Racimo' }]; %>
        <% posiciones.forEach((posicion) => { %>
          <tr>
            <th scope="row"><%= posicion.nombre %></th>
            <% detalle.matriz.forEach((estado) => { const cantidad = estado.posiciones.find((item) => item.idEstadoPosicion === posicion.id); %>
              <td data-label="<%= estado.nombre %>"><%= cantidad ? cantidad.cantidad : 0 %></td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
      <tfoot><tr><th>Total general</th><th colspan="3"><%= detalle.totalBichos %></th></tr></tfoot>
    </table>
  </div>
</section>

<% if (detalle.imagenes && detalle.imagenes.length > 0) { %>
  <section class="info-panel chanchitos-evidence-section">
    <h2>Imagenes de evidencia</h2>
    <div class="chanchitos-evidence-gallery">
      <% detalle.imagenes.forEach((imagen) => { %>
        <a
          class="chanchitos-evidence-trigger"
          href="<%= imagen.url %>"
          data-chanchitos-evidence="true"
          data-evidence-label="Evidencia <%= imagen.posicion %> del monitoreo"
          aria-label="Ampliar evidencia <%= imagen.posicion %> del monitoreo"
        >
          <img
            src="<%= imagen.url %>"
            alt="Evidencia <%= imagen.posicion %> del monitoreo"
            loading="lazy"
          >
        </a>
      <% }) %>
    </div>
  </section>
<% } %>
