<section class="page-header">
  <div>
    <p class="eyebrow">Monitoreos</p>
    <h1>Registrar Monitoreo</h1>
    <p>Primer paso del registro: seleccione el origen de la muestra y complete los datos base del formulario.</p>
  </div>

  <a class="button button-secondary" href="/home">Volver al inicio</a>
</section>

<section class="info-panel">
  <strong>Resolucion automatica en backend</strong>
  <p>El usuario solo selecciona fundo, campo/productor, variedad y cuartel. El sistema resuelve internamente SDP y trazabilidad desde el catalogo de marcha blanca.</p>
</section>

<% if (success) { %>
  <div class="alert alert-success" role="status"><%= success %></div>
<% } %>

<% if (errors && errors.length > 0) { %>
  <div class="alert" role="alert">
    <strong>Revise los datos ingresados.</strong>
    <ul class="message-list">
      <% errors.forEach((message) => { %>
        <li><%= message %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<div id="monitoreo-combos-error" class="alert" role="alert" hidden></div>

<section class="form-panel">
  <form id="monitoreo-form" class="form form-grid" action="/monitoreos" method="POST" autocomplete="off" novalidate>
    <input id="confirmacionResumen" name="confirmacionResumen" type="hidden" value="0">

    <div class="form-group">
      <label for="genFundo">Fundo</label>
      <select id="genFundo" name="genFundo" data-selected="<%= values.genFundo %>" required>
        <option value="">Seleccione un fundo</option>
        <% opciones.fundos.forEach((item) => { %>
          <option value="<%= item.value %>" <%= Number(values.genFundo) === Number(item.value) ? 'selected' : '' %>><%= item.label %></option>
        <% }) %>
      </select>
    </div>

    <div class="form-group">
      <label for="genCampo">Campo / Productor</label>
      <select id="genCampo" name="genCampo" data-selected="<%= values.genCampo %>" disabled required>
        <option value="">Seleccione primero un fundo</option>
      </select>
    </div>

    <div class="form-group">
      <label for="genVariedad">Variedad</label>
      <select id="genVariedad" name="genVariedad" data-selected="<%= values.genVariedad %>" disabled required>
        <option value="">Seleccione primero un campo</option>
      </select>
    </div>

    <div class="form-group">
      <label for="idCatalogoSdp">Cuartel</label>
      <select id="idCatalogoSdp" name="idCatalogoSdp" data-selected="<%= values.idCatalogoSdp %>" disabled required>
        <option value="">Seleccione primero una variedad</option>
      </select>
    </div>

    <div class="form-group">
      <label for="idEstructura">Estructura</label>
      <select id="idEstructura" name="idEstructura" required>
        <option value="">Seleccione una estructura</option>
        <% opciones.estructuras.forEach((item) => { %>
          <option value="<%= item.value %>" <%= Number(values.idEstructura) === Number(item.value) ? 'selected' : '' %>><%= item.label %></option>
        <% }) %>
      </select>
    </div>

    <div class="form-group">
      <label for="id_muestreador">Muestreador</label>
      <select id="id_muestreador" name="id_muestreador" required>
        <option value="">Seleccione un muestreador</option>
        <% opciones.muestreadores.forEach((item) => { %>
          <option value="<%= item.value %>" <%= Number(values.idMuestreador) === Number(item.value) ? 'selected' : '' %>><%= item.label %></option>
        <% }) %>
      </select>
    </div>

    <div class="form-group">
      <label for="id_estadofenologico">Estado fenologico</label>
      <select id="id_estadofenologico" name="id_estadofenologico" required>
        <option value="">Seleccione un estado fenologico</option>
        <% opciones.estadosFenologicos.forEach((item) => { %>
          <option value="<%= item.value %>" <%= Number(values.idEstadoFenologico) === Number(item.value) ? 'selected' : '' %>><%= item.label %></option>
        <% }) %>
      </select>
    </div>

    <div class="form-group">
      <label for="fechaSolicitudMuestra">Fecha solicitud muestra</label>
      <input
        id="fechaSolicitudMuestra"
        name="fechaSolicitudMuestra"
        type="date"
        value="<%= values.fechaSolicitudMuestra %>"
        required
      >
    </div>

    <div class="form-group">
      <label for="fechaRecepcionMuestra">Fecha recepcion muestra</label>
      <input
        id="fechaRecepcionMuestra"
        name="fechaRecepcionMuestra"
        type="date"
        value="<%= values.fechaRecepcionMuestra %>"
        required
      >
    </div>

    <div class="form-group">
      <label for="fechaRevisionMuestra">Fecha revision muestra</label>
      <input
        id="fechaRevisionMuestra"
        name="fechaRevisionMuestra"
        type="date"
        value="<%= values.fechaRevisionMuestra %>"
        required
      >
    </div>

    <div class="form-group form-group-full">
      <label for="observacionGeneral">Observacion general</label>
      <textarea
        id="observacionGeneral"
        name="observacionGeneral"
        rows="4"
        placeholder="Ingrese observaciones relevantes para el muestreo"
      ><%= values.observacionGeneral %></textarea>
    </div>

    <div class="form-actions">
      <a class="button button-secondary" href="/home">Cancelar</a>
      <button class="button button-primary button-fit" type="submit">Guardar</button>
    </div>
  </form>
</section>

<div id="monitoreo-confirmacion-modal" class="modal-shell is-hidden" hidden aria-hidden="true">
  <div class="modal-backdrop" data-close-modal="true"></div>
  <section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="modal-confirmacion-title">
    <div class="modal-header">
      <div>
        <p class="eyebrow">Confirmacion previa</p>
        <h2 id="modal-confirmacion-title">Resumen del origen resuelto</h2>
        <p>Revise la ubicacion y los datos productivos antes de confirmar el guardado del monitoreo.</p>
      </div>
      <button class="modal-close" type="button" data-close-modal="true" aria-label="Cerrar resumen">x</button>
    </div>

    <div id="monitoreo-modal-error" class="alert" role="alert" hidden></div>

    <div class="modal-grid">
      <section class="summary-panel">
        <h3>Ubicacion</h3>
        <dl class="summary-list">
          <div>
            <dt>Fundo</dt>
            <dd data-resumen="fundo">-</dd>
          </div>
          <div>
            <dt>Campo / Productor</dt>
            <dd data-resumen="campo">-</dd>
          </div>
          <div>
            <dt>Variedad</dt>
            <dd data-resumen="variedad">-</dd>
          </div>
          <div>
            <dt>Cuartel</dt>
            <dd data-resumen="cuartel">-</dd>
          </div>
        </dl>
      </section>

      <section class="summary-panel summary-panel-highlight">
        <h3>Resolucion automatica</h3>
        <dl class="summary-list">
          <div>
            <dt>SDP</dt>
            <dd data-resumen="sdp">-</dd>
          </div>
          <div>
            <dt>CSG</dt>
            <dd data-resumen="csg">-</dd>
          </div>
          <div>
            <dt>Trazabilidad</dt>
            <dd data-resumen="trazabilidad">-</dd>
          </div>
          <div>
            <dt>Estructura</dt>
            <dd data-resumen="estructura">-</dd>
          </div>
        </dl>
      </section>

      <section class="summary-panel summary-panel-full">
        <h3>Fechas seleccionadas</h3>
        <dl class="summary-list summary-list-inline">
          <div>
            <dt>Solicitud muestra</dt>
            <dd data-resumen="fechaSolicitudMuestra">-</dd>
          </div>
          <div>
            <dt>Recepcion muestra</dt>
            <dd data-resumen="fechaRecepcionMuestra">-</dd>
          </div>
          <div>
            <dt>Revision muestra</dt>
            <dd data-resumen="fechaRevisionMuestra">-</dd>
          </div>
        </dl>
      </section>
    </div>

    <div class="summary-note">
      <strong>Observacion general</strong>
      <p data-resumen="observacionGeneral">Sin observacion general registrada.</p>
    </div>

    <div class="form-actions modal-actions">
      <button class="button button-secondary button-fit" type="button" data-close-modal="true">Cancelar</button>
      <button id="modal-confirmar-submit" class="button button-primary button-fit" type="button">Confirmar y guardar</button>
    </div>
  </section>
</div>

<script src="/js/monitoreos-form.js"></script>
