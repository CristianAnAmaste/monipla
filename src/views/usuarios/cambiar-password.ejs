<section class="page-header">
  <div>
    <p class="eyebrow">Administracion</p>
    <h1>Cambiar contrasena</h1>
    <p>Actualice la contrasena de acceso sin exponer la clave actual.</p>
  </div>

  <a class="button button-secondary" href="/usuarios">Volver al listado</a>
</section>

<section class="user-summary">
  <span>Usuario</span>
  <strong><%= usuarioEditar.nombre %></strong>
  <small><%= usuarioEditar.correo %></small>
</section>

<% if (errors && errors.length > 0) { %>
  <div class="alert" role="alert">
    <strong>Revise los datos ingresados.</strong>
    <ul class="message-list">
      <% errors.forEach((message) => { %>
        <li><%= message %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<section class="form-panel">
  <form class="form form-grid" action="/usuarios/<%= usuarioEditar.id %>/password" method="POST" autocomplete="off" novalidate>
    <div class="form-group">
      <label for="contrasena">Nueva contrasena</label>
      <input id="contrasena" name="contrasena" type="password" required>
    </div>

    <div class="form-group">
      <label for="confirmarContrasena">Confirmar nueva contrasena</label>
      <input id="confirmarContrasena" name="confirmarContrasena" type="password" required>
    </div>

    <div class="form-actions">
      <a class="button button-secondary" href="/usuarios">Cancelar</a>
      <button class="button button-primary button-fit" type="submit">Actualizar contrasena</button>
    </div>
  </form>
</section>
